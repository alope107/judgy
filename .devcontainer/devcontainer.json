{
  "name": "agent-sandbox",

  "build": {
    "dockerfile": "Dockerfile"
  },

  // Docker-in-Docker: a dockerd of our own inside this container, NOT the
  // host's daemon. Deliberately not docker-outside-of-docker (bind-mounting
  // /var/run/docker.sock): that daemon runs as host root and would let anything
  // in here mount arbitrary host paths, which defeats the "mount ONLY this
  // repo" rule below. Nested containers can only see what we hand them.
  //
  // This is what `docker compose up -d` (PostgreSQL, per CLAUDE.md) needs.
  //
  // Cost, stated plainly: the feature declares `privileged: true`, so the OUTER
  // container now runs with all capabilities and an unconfined seccomp profile.
  // That supersedes the note this comment replaced, which said seccomp was back
  // to Docker's default now that bubblewrap was gone — a nested engine needs
  // the same syscalls the sandbox did, and then some.
  //
  // Pinned to an exact feature version, matching how npm deps are pinned.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "moby": true,
      "dockerDashComposeVersion": "latest"
    }
  },

  // The feature installs /usr/local/share/docker-init.sh as the entrypoint;
  // that script starts dockerd, and starts it via `sudo` when it is not already
  // root. The Dockerfile ends with `USER node` and installs no sudo, so without
  // this the daemon would fail to start and every `docker` call would report a
  // dead socket. containerUser only sets who runs the entrypoint — remoteUser
  // below is still `node`, so the shell, Claude, and postCreate are unchanged.
  "containerUser": "root",

  // Chromium uses shared memory for renderer surfaces. Docker gives a container
  // 64 MB of /dev/shm, and past that Chromium kills renderers — surfacing as a
  // tab that dies mid-run rather than as an error, which is the silent failure
  // mode CLAUDE.md forbids. The Task 1 fuzz harness drives two live Monaco
  // editors at once, so it will get there.
  //
  // The two flags do NOT compose. --ipc=host replaces the container's IPC
  // namespace with the host's, so /dev/shm becomes the host's and --shm-size,
  // which sizes a namespace we no longer have, is ignored. Measured in this
  // container rather than assumed, `df -h /dev/shm` in each case:
  //
  //   neither            64M    Docker's default — the size that kills renderers
  //   --shm-size=1g only 1.0G
  //   --ipc=host only    3.8G   the host's /dev/shm
  //   both               3.8G   --shm-size had no effect
  //
  // --ipc=host is the one doing the work, and it is what Playwright's docs
  // actually recommend, in those words: "Without it, Chromium can run out of
  // memory and crash." They do not mention --shm-size at all.
  //
  // --shm-size=1g is kept deliberately, as inert-but-correct fallback: it costs
  // nothing while --ipc=host is present, and if --ipc=host is ever removed for
  // the isolation reason below, it is what stops /dev/shm reverting to 64 MB and
  // reintroducing the silent renderer death. Do not delete it as dead config
  // without also confirming what /dev/shm ends up as.
  //
  // --ipc=host shares the host's IPC namespace, which is a real reduction in
  // isolation and worth naming given how carefully the rest of this file avoids
  // the host. The docker-in-docker feature below already declares
  // `privileged: true`, so the marginal loss here is small — but if that ever
  // changes, revisit this line rather than assuming it is free.
  //
  // Not used: --disable-dev-shm-usage. It redirects shared memory to /tmp and
  // so changes what the harness is actually exercising.
  "runArgs": ["--shm-size=1g", "--ipc=host"],

  // Mount ONLY this repo. Never open the parent directory in this container.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",

  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=pnpm-store-${devcontainerId},target=/home/node/.local/share/pnpm/store,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },

  // The PAT goes in remoteEnv, not containerEnv: it stays out of container
  // metadata (docker inspect) and picks up a rotated token on reconnect
  // rather than needing a rebuild. Resolved on the HOST from the environment
  // of whatever launched VS Code — this repo is public, never a literal here.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:AGENT_GH_TOKEN}"
  },

  "remoteUser": "node"
}