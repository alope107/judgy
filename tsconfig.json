{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "preserve",

    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // ADR-0006: the vendored y-monaco binding stays as .js with JSDoc so it remains
    // diffable against upstream. It is compiled but never type-checked, and it must never
    // be converted to TypeScript.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["keystone.ts", "prisma.config.ts", "src/**/*", "test/**/*"],
  "exclude": ["node_modules", ".keystone", "src/vendor/**", "web/dist", "spike"]
}
