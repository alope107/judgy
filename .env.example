# Copy to .env for local development. Never commit .env (CLAUDE.md).
#
# Matches the credentials in docker-compose.yml. This is a throwaway local database;
# it must never point at a production host (CLAUDE.md).
DATABASE_URL=postgres://judgy:judgy@localhost:5432/judgy

# Keystone session secret. Any 32+ character string works locally; generate a real one
# per environment. Not used until auth is wired (ADR-0008).
SESSION_SECRET=local-development-session-secret-not-a-real-one
